# Used by `npm run build` (and `vite --mode production`).
# Public client, no secrets here.
VITE_KEYCLOAK_URL=https://auth.teaz.pro
VITE_KEYCLOAK_REALM=teazpro
VITE_KEYCLOAK_CLIENT_ID=portal

# Status tile reads Pulse's /api/health (Pulse allows this origin via CORS).
VITE_PULSE_URL=https://pulse.teaz.pro

# Study tile reads Study's /api/overview (Study allows this origin via CORS).
VITE_STUDY_URL=https://study.teaz.pro

# Transit tile reads Transit's /api/board (Transit allows this origin via CORS).
VITE_TRANSIT_URL=https://transit.teaz.pro
